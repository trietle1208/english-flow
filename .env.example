# Postgres connection string (Phase 02+).
#
# Hostname depends on how you run Postgres:
#   - "localhost" (this value) — Postgres runs in Docker, app runs locally
#     with `npm run dev` (Option B), or Postgres runs outside Docker entirely.
#   - "postgres" — only when the app itself also runs *inside* Docker
#     (Option A). You don't need to edit this file for that:
#     `docker-compose.yml` already sets DATABASE_URL for the `app` service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_learning

# Public app URL, used for absolute links (emails, OG tags, better-auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth (Phase 04) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
